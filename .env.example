# Server Configuration
APP_ENV=development
DEBUG=true

# Gemini API Configuration
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Available models (use the one your key has access to):
#   gemini-3.6-flash  — latest fast model (new/restricted keys)
#   gemini-2.5-flash  — stable fast model (standard keys)
#   gemini-1.5-flash  — legacy fast model (broad availability)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: AI Avatar Video Providers (leave blank to use local canvas engine)
# HEYGEN_API_KEY=your_heygen_api_key_here
# DID_API_KEY=your_did_api_key_here

# Database Configuration (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./ai_brain.db

# Chroma Vector DB Persistence Directory
CHROMA_PERSIST_DIRECTORY=./chroma_data
